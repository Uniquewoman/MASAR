// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────
model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  xp           Int            @default(0)
  streak       Int            @default(0)
  language     String         @default("ar")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  progress     UserProgress[]
  attempts     LevelAttempt[]
}

// ─── Tracks (SE, AI, CS, NW, FI) ─────────────────────────────────────────────
model Track {
  id       String    @id // "SE", "AI", "CS", "NW", "FI"
  name     String
  name_ar  String
  color    String    @default("#0d9488")
  slogan   String
  slogan_ar String
  desc     String
  desc_ar  String
  sections Section[]
}

// ─── Sections within a Track ─────────────────────────────────────────────────
model Section {
  id       String    @id @default(cuid())
  trackId  String
  index    Int       // order within track (0-based)
  title    String
  title_ar String
  desc     String
  desc_ar  String
  track    Track     @relation(fields: [trackId], references: [id])
  levels   Level[]
  lessons  Lesson[]
}

// ─── Levels within a Section ─────────────────────────────────────────────────
model Level {
  id        String         @id @default(cuid())
  sectionId String
  number    Int            // 1-5
  title     String
  title_ar  String
  topics    String         // JSON array stored as string (SQLite compat)
  section   Section        @relation(fields: [sectionId], references: [id])
  questions Question[]
  progress  UserProgress[]

  @@unique([sectionId, number])
}

// ─── Questions Bank ───────────────────────────────────────────────────────────
model Question {
  id         String  @id @default(cuid())
  levelId    String
  type       String  // mcq | true_false | code_output | bug_find | best_practice | scenario
  q_ar       String
  q_en       String
  options_ar String  // JSON array as string
  options_en String  // JSON array as string
  answer     Int     // index of correct option (0-based)
  difficulty String  // easy | medium | hard
  code       String? // optional code snippet
  visualType String? // memory | list | console
  visualData String? // JSON as string
  lang       String? // python | javascript | java | general
  level      Level   @relation(fields: [levelId], references: [id])
}

// ─── Lessons (per Level within a Section) ────────────────────────────────────
model Lesson {
  id         String  @id @default(cuid())
  sectionId  String
  levelNum   Int     // 1-5 — which level this lesson belongs to
  order      Int     @default(0)
  title      String
  title_ar   String
  body_ar    String  // full explanation in Arabic
  body_en    String  // full explanation in English
  code       String? // code example
  commonErr  String? // common mistakes (text)
  summary_ar String? // quick summary
  summary_en String?
  videoUrl   String? // YouTube embed placeholder
  duration   String? // "10:30"
  section    Section @relation(fields: [sectionId], references: [id])
}

// ─── User Progress per Level ──────────────────────────────────────────────────
model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  levelId   String
  unlocked  Boolean  @default(false)
  completed Boolean  @default(false)
  bestScore Int      @default(0)
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  level     Level    @relation(fields: [levelId], references: [id])

  @@unique([userId, levelId])
}

// ─── Each Play Attempt Log ────────────────────────────────────────────────────
model LevelAttempt {
  id           String   @id @default(cuid())
  userId       String
  levelId      String
  correctCount Int
  mistakes     Int
  passed       Boolean
  xpEarned     Int      @default(0)
  durationSec  Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}
